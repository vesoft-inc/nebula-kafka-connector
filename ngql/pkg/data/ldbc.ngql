"""
CREATE GRAPH TYPE IF NOT EXISTS tck_ldbc_type AS {
    NODE Place (:City&Country&Continent {id INT PRIMARY KEY, name STRING, url STRING, kind STRING}),
    NODE Forum (:Forum {id INT PRIMARY KEY, title STRING, creationDate LOCAL DATETIME}),
    NODE Comment (:Comment&Message {id INT PRIMARY KEY, creationDate LOCAL DATETIME, locationIP STRING, browserUsed STRING, content STRING, extent INT}),
    NODE Person (:Person {id INT PRIMARY KEY, firstName STRING, lastName STRING, gender STRING, birthday DATE, creationDate LOCAL DATETIME, locationIP STRING, browserUsed STRING}),
    NODE Tag (:Tag {id INT PRIMARY KEY, name STRING, url STRING}),
    NODE Post (:Post&Message {id INT PRIMARY KEY, imageFile STRING, creationDate LOCAL DATETIME, locationIP STRING, browserUsed STRING, content STRING, extent INT, language STRING}),
    NODE TagClass (:TagClass {id INT PRIMARY KEY, name STRING, url STRING}),
    NODE Organisation (:University&Company {id INT PRIMARY KEY, kind STRING, name STRING, url STRING}),
    EDGE HAS_INTEREST (Person)-[:HAS_INTEREST]->(Tag),
    EDGE WORK_AT (Person)-[:WORK_AT{workFrom INT}]->(Organisation),
    EDGE IS_LOCATED_IN_1 (Person)-[:IS_LOCATED_IN]->(Place),
    EDGE IS_LOCATED_IN_2 (Comment)-[:IS_LOCATED_IN]->(Place),
    EDGE IS_LOCATED_IN_3 (Post)-[:IS_LOCATED_IN]->(Place),
    EDGE IS_LOCATED_IN_4 (Organisation)-[:IS_LOCATED_IN]->(Place),
    EDGE IS_PART_OF (Place)-[:IS_PART_OF]->(Place),
    EDGE HAS_TYPE (Tag)-[:HAS_TYPE]->(TagClass),
    EDGE REPLY_OF_1 (Comment)-[:REPLY_OF]->(Post),
    EDGE REPLY_OF_2 (Comment)-[:REPLY_OF]->(Comment),
    EDGE KNOWS (Person)-[:KNOWS{creationDate LOCAL DATETIME}]->(Person),
    EDGE FOLLOWS (Person)-[:FOLLOWS{src INT, dst INT}]->(Person),
    EDGE CONTAINER_OF (Forum)-[:CONTAINER_OF]->(Post),
    EDGE HAS_MEMBER (Forum)-[:HAS_MEMBER]->(Person),
    EDGE HAS_MODERATOR (Forum)-[:HAS_MODERATOR]->(Person),
    EDGE STUDY_AT (Person)-[:STUDY_AT{classYear INT}]->(Organisation),
    EDGE IS_SUBCLASS_OF (TagClass)-[:IS_SUBCLASS_OF]->(TagClass),
    EDGE HAS_TAG_1 (Forum)-[:HAS_TAG]->(Tag),
    EDGE HAS_TAG_2 (Post)-[:HAS_TAG]->(Tag),
    EDGE HAS_TAG_3 (Comment)-[:HAS_TAG]->(Tag),
    EDGE HAS_CREATOR_1 (Post)-[:HAS_CREATOR]->(Person),
    EDGE HAS_CREATOR_2 (Comment)-[:HAS_CREATOR]->(Person),
    EDGE LIKES_1 (Person)-[:LIKES{creationDate LOCAL DATETIME}]->(Post),
    EDGE LIKES_2 (Person)-[:LIKES{creationDate LOCAL DATETIME}]->(Comment)}
"""

"""
:sleep 10
"""

"""
CREATE GRAPH ldbc :: tck_ldbc_type
"""

:sleep 10

