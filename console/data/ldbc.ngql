USE ldbc INSERT NODE Post
({id:1, imageFile:"post1.png", creationDate:1, locationIP:"192.168.1", browserUsed:"Chrome", content:"post1", extent:8, language:"Chinese"}),
({id:2, imageFile:"post2.png", creationDate:2, locationIP:"192.168.2", browserUsed:"Firefox", content:"post2", extent:8, language:"English"}),
({id:3, imageFile:"post3.png", creationDate:3, locationIP:"192.168.3", browserUsed:"IE", content:"post3", extent:8, language:"English"}),
({id:4, imageFile:"post4.png", creationDate:4, locationIP:"192.168.4", browserUsed:"Chrome", content:"post4", extent:8, language:"French"})

