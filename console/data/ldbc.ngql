CREATE GRAPH TYPE ldbc_type IF NOT EXISTS AS GRAPH TYPE {
(Place(id) LABELS City&Country&Continent {id INT, name STRING, url STRING, kind STRING}),
(Forum(id) LABEL Forum {id INT, title STRING, creationDate INT}),
(Comment(id) LABELS Comment&Message {id INT, creationDate INT, locationIP STRING, browserUsed STRING, content STRING, extent INT}),
(Person(id) LABEL Person {id INT, firstName STRING, lastName STRING, gender STRING, birthday STRING, creationDate INT, locationIP STRING, browserUsed STRING}),
(Tag(id) LABEL Tag {id INT, name STRING, url STRING}),
(Post(id) LABELS Post&Message {id INT, imageFile STRING, creationDate INT, locationIP STRING, browserUsed STRING, content STRING, extent INT, language STRING}),
(TagClass(id) LABEL TagClass {id INT, name STRING, url STRING}),
(Organisation(id) LABELS University&Company {id INT, kind STRING, name STRING, url STRING}),
(Person)-[HAS_INTEREST:HAS_INTEREST]->(Tag),
(Person)-[WORK_AT:WORK_AT{workFrom INT}]->(Organisation),
(Person)-[IS_LOCATED_IN_1:IS_LOCATED_IN]->(Place),
(Comment)-[IS_LOCATED_IN_2:IS_LOCATED_IN]->(Place),
(Post)-[IS_LOCATED_IN_3:IS_LOCATED_IN]->(Place),
(Organisation)-[IS_LOCATED_IN_4:IS_LOCATED_IN]->(Place),
(Place)-[IS_PART_OF:IS_PART_OF]->(Place),
(Tag)-[HAS_TYPE:HAS_TYPE]->(TagClass),
(Comment)-[REPLY_OF_1:REPLY_OF]->(Post),
(Comment)-[REPLY_OF_2:REPLY_OF]->(Comment),
(Person)-[KNOWS:KNOWS{creationDate INT}]->(Person),
(Forum)-[CONTAINER_OF:CONTAINER_OF]->(Post),
(Forum)-[HAS_MEMBER:HAS_MEMBER]->(Person),
(Forum)-[HAS_MODERATOR:HAS_MODERATOR]->(Person),
(Person)-[STUDY_AT:STUDY_AT{classYear INT}]->(Organisation),
(TagClass)-[IS_SUBCLASS_OF:IS_SUBCLASS_OF]->(TagClass),
(Forum)-[HAS_TAG_1:HAS_TAG]->(Tag),
(Post)-[HAS_TAG_2:HAS_TAG]->(Tag),
(Comment)-[HAS_TAG_3:HAS_TAG]->(Tag),
(Post)-[HAS_CREATOR_1:HAS_CREATOR]->(Person),
(Comment)-[HAS_CREATOR_2:HAS_CREATOR]->(Person),
(Person)-[LIKES_1:LIKES{creationDate INT}]->(Post),
(Person)-[LIKES_2:LIKES{creationDate INT}]->(Comment)}

:sleep 10

CREATE GRAPH ldbc IF NOT EXISTS OF ldbc_type

:sleep 10

// (Place(id) LABELS City&Country&Continent {id INT, name STRING, url STRING, kind
// STRING})
USE ldbc INSERT NODE Place
({id:1, name:"Beijing", url:"https://beijing.com", kind:"city"}),
({id:2, name:"Shanghai", url:"https://shanghai.com", kind:"city"}),
({id:3, name:"Hangzhou", url:"https://hangzhou.com", kind:"city"}),
({id:4, name:"Chongqing", url:"https://chongqing.com", kind:"city"}),
({id:5, name:"Chengdu", url:"https://chengdu.com", kind:"city"}),
({id:6, name:"Shenzhen", url:"https://shenzhen.com", kind:"city"})

// (Forum(id) LABEL Forum {id INT, title STRING, creationDate INT})
USE ldbc INSERT NODE Forum
({id:1, title:"forum1", creationDate:1}),
({id:2, title:"forum2", creationDate:2}),
({id:3, title:"forum3", creationDate:3}),
({id:4, title:"forum4", creationDate:4})

// (Comment(id) LABELS Comment&Message {id INT, creationDate INT, locationIP STRING,
// browserUsed STRING, content STRING, extent INT})
USE ldbc INSERT NODE Comment
({id:1, creationDate:1, locationIP:"192.168.1", browserUsed:"Chrome", content:"comment1", extent:8}),
({id:2, creationDate:2, locationIP:"192.168.2", browserUsed:"Firefox", content:"comment2", extent:8}),
({id:3, creationDate:3, locationIP:"192.168.3", browserUsed:"IE", content:"comment3", extent:8}),
({id:4, creationDate:4, locationIP:"192.168.4", browserUsed:"Chrome", content:"comment4", extent:8})

// (Person(id) LABEL Person {id INT, firstName STRING, lastName STRING, gender STRING,
// birthday STRING, creationDate INT, locationIP STRING, browserUsed STRING})
USE ldbc INSERT NODE Person
({id:1, firstName:"Kyle", lastName:"cao", gender:"male", birthday:"10-26", creationDate:1, locationIP:"192.168.1", browserUsed:"Chrome"}),
({id:2, firstName:"Tim", lastName:"Duncan", gender:"male", birthday:"1-3", creationDate:2, locationIP:"192.168.2", browserUsed:"IE"}),
({id:3, firstName:"Ming", lastName:"Yao", gender:"male", birthday:"10-11", creationDate:3, locationIP:"192.168.3", browserUsed:"Firefox"}),
({id:4, firstName:"Sophie", lastName:"Marceau", gender:"female", birthday:"10-20", creationDate:4, locationIP:"192.168.4", browserUsed:"Chrome"})

