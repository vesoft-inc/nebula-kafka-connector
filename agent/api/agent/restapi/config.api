syntax = "v1"

type (
	GetComponentConfigReq {
		Component string `form:"component"`
	}
	GetComponentConfigResp {
		Config map[string]interface{} `json:"config"`
	}
	SetComponentConfigReq {
		Component string                 `json:"component"`
		Config    map[string]interface{} `json:"config"`
	}
	SetComponentConfigResp  {}
)

@server (
	group: config
)
service agent-api {
	@doc "Get Component Config"
	@handler GetComponentConfig
	get /api/v1/component-config (GetComponentConfigReq) returns (GetComponentConfigResp)

	@doc "Set Component Config"
	@handler SetComponentConfig
	post /api/v1/component-config (SetComponentConfigReq) returns (SetComponentConfigResp)
}

